# Copy to .env.docker and replace both development secrets with random values.
# Values used by docker-compose.yml for the local PostgreSQL service.
POSTGRES_USER=futsal
POSTGRES_PASSWORD=replace_with_a_local_database_password
POSTGRES_DB=futsal_academy

# Required by app runtime; use a PostgreSQL service hostname from Compose.
# For Supabase: paste your project's session-pooler connection URI here
# (Project Settings → Database → Connection string). TLS is enabled
# automatically for Supabase/Neon hosts, or force it with DB_SSL=true.
# Example (Supabase):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://futsal:replace_with_a_local_database_password@db:5432/futsal_academy?sslmode=disable
SESSION_SECRET=replace_with_random_secret_at_least_32_chars
CSRF_SECRET=replace_with_random_secret_at_least_32_chars
NODE_ENV=production

# Test-only: configure only an isolated PostgreSQL database ending in _test.
TEST_DATABASE_URL=

# Required only when provisioning the initial Admin; password is prompted hidden.
INITIAL_ADMIN_EMAIL=admin@example.local

# Optional: defaults shown here for local Docker use.
ACADEMY_TIMEZONE=Asia/Jakarta
DB_POOL_MAX=5
# Set DB_POOL_MAX=1 when deploying to Vercel (serverless, one pool per instance).
# DB_SSL=true forces TLS to PostgreSQL (auto-detected for Supabase/Neon hosts).
DB_SSL=
PGLITE_DATA_DIR=
SESSION_COOKIE_NAME=futsal_session
CSRF_COOKIE_NAME=futsal_csrf
SESSION_LIFETIME_SECONDS=43200
SESSION_ABSOLUTE_MAX_SECONDS=604800
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_BAN_MINUTES=15
NORMAL_MOVE_LIMIT_PER_ENTITLEMENT=2
# PGLITE_DEBUG=1-5 enables local PgLite diagnostics only.
PGLITE_DEBUG=0
